# Dart/Flutter — cobre packages/evo_motor e app/ (o gitignore específico
# gerado pelo `flutter create` dentro de app/ continua valendo também).
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# Harness de testes das Security Rules (test/rules/) — Node, isolado do app.
node_modules/

# Firebase local: logs do emulador e cache de deploy. `firebase.json`,
# `firestore.rules` e `firestore.indexes.json` SÃO versionados.
.firebase/
*-debug.log
firestore-debug.log
firebase-debug.log
ui-debug.log

# IDEs
.idea/
*.iml

# SO
.DS_Store

# Firebase — credenciais e artefatos que NUNCA podem ir pro repositório
# público (ver Etapa 0 do handoff do `mobile`). NOTA: isto é disjunto de
# `app/lib/firebase_options.dart` e `.firebaserc`, que SÃO versionados de
# propósito — a config web do Firebase não é segredo (ver o comentário no
# topo de `firebase_options.dart`). O que entra aqui é credencial de
# verdade: conta de serviço, token de bypass de atestação, e o backup local
# mais provável de acabar largado na pasta do projeto.
.env
.env.*
**/google-services.json
**/GoogleService-Info.plist
**/*serviceAccount*.json
**/*-firebase-adminsdk-*.json
**/app_check_debug_token*
evo-lab-backup-*.json
